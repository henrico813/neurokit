{
  "name": "echo",
  "spec": 1,
  "broker_url_env": "ECHO_URL",
  "max_handlers": 2,
  "program": ["python3", "-m", "neurokit_handler", "echo.handler"],
  "check": ["python3", "-m", "neurokit_handler", "--check", "echo.handler"],
  "commands": {
    "echo": {
      "max_body_bytes": 1024,
      "max_response_bytes": 4096,
      "deadline_ms": 5000,
      "args": {
        "text": {"type": "string", "max_length": 200},
        "times": {"type": "integer", "min": 1, "max": 5, "optional": true}
      }
    },
    "set-greeting": {
      "mutating": true,
      "lock": "write",
      "approval": true,
      "max_body_bytes": 1024,
      "max_response_bytes": 1024,
      "deadline_ms": 5000,
      "args": {"greeting": {"type": "string", "max_length": 100}},
      "errors": ["blank-greeting"]
    }
  }
}
